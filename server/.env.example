PORT=5001
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string

# Local MongoDB works only on your own machine. To share one database with the
# team, use a MongoDB Atlas connection string (mongodb+srv://...) instead.
MONGO_URI=mongodb://127.0.0.1:27017/community_discussion

# Optional: real email for password reset. If SMTP_HOST is empty,
# reset links are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
